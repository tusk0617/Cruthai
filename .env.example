# Postgres. If empty, an in-memory Postgres (pg-mem) is used — data resets on restart.
DATABASE_URL=postgres://clipplan:clipplan@localhost:5432/clipplan
# Required in production. Any long random string.
AUTH_SECRET=change-me-to-a-long-random-string
# AI provider: mock | openai | gemini
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Comma-separated emails that get admin access (can also set role=admin in DB)
ADMIN_EMAILS=admin@clipplan.local
# Rate limiting across serverless instances (required on Vercel). Free tier at upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
